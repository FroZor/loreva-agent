{
  // Required outbound WSS address of the public or self-hosted portal.
  "portal_url": "wss://portal.example.com:27460",

  // Required short-lived token issued by the portal. Never commit a real value.
  "enrollment_token": "0123456789abcdef.replace-with-secret",

  // Optional PEM trust anchor for a self-hosted portal whose certificate is not
  // already trusted by the operating system. Obtain it through a trusted channel.
  "portal_ca": "-----BEGIN CERTIFICATE-----\n<portal-certificate>\n-----END CERTIFICATE-----\n",

  // Required ML-DSA-65 portal identity root. Obtain it from the portal and do not
  // replace it with an unverified value.
  "portal_pq_root": {
    "kty": "AKP",
    "alg": "ML-DSA-65",
    "pub": "<base64url-without-padding-public-key>"
  },

  // Optional identity directory. When omitted, LOREVA_STATE_DIR or the platform
  // user configuration directory is used.
  "state_dir": "/var/lib/loreva-agent",

  // Development only. Production connections must use wss://. When enabled,
  // ws:// remains restricted to loopback portal addresses.
  "allow_development_ws": false
}
